# --- Supabase (database, logins, photo storage) — required ---
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (server only). Needed for Stripe/Calendly webhooks and ADMIN_EMAILS.
SUPABASE_SECRET_KEY=sb_secret_...

# Comma-separated emails that become admins automatically the first time they log in.
ADMIN_EMAILS=owner@example.com

# Public URL of the site (used for share previews). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=https://waitingforpaws.com

# --- Stripe (online payments) — optional ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Calendly booking sync — optional ---
# The scheduler link itself is set in Admin → Settings → Booking.
CALENDLY_WEBHOOK_SIGNING_KEY=
