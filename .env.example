# --- Supabase (database, logins, photo storage) — required ---
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (server only). Needed for ADMIN_EMAILS and the Instagram feed.
SUPABASE_SECRET_KEY=sb_secret_...

# Comma-separated emails that become admins automatically the first time they log in.
ADMIN_EMAILS=owner@example.com

# Public URL of the site (used for share previews). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=https://waitingforpaws.com

# --- Stripe (online payments) — optional ---
# The webhook's signing secret goes in Supabase Vault as `stripe_webhook_secret` (see README), not here.
STRIPE_SECRET_KEY=sk_live_...

# --- Instagram feed on the website — optional ---
# Meta app → Instagram → API setup with Instagram login. Turns on the "Connect Instagram" button in
# Admin → Integrations (also needs SUPABASE_SECRET_KEY). See README → Instagram feed.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Booking emails (confirmations, reminders, alerts) are sent from the database with Resend.
# Store the Resend API key in Supabase Vault as `resend_api_key` (see README) — no env var needed.
